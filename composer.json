{
  "name": "k2gl/token-status-list",
  "description": "Token Status List (draft-ietf-oauth-status-list) in pure PHP: publish and check revocation status for JWTs, SD-JWTs and SD-JWT VCs",
  "homepage": "https://github.com/k2gl/token-status-list",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "token-status-list",
    "status-list",
    "revocation",
    "sd-jwt",
    "sd-jwt-vc",
    "verifiable-credentials",
    "eudi",
    "openid4vc",
    "jwt",
    "identity"
  ],
  "authors": [
    {
      "name": "Nick Harin",
      "email": "l0gic@ya.ru"
    }
  ],
  "support": {
    "issues": "https://github.com/k2gl/token-status-list/issues",
    "source": "https://github.com/k2gl/token-status-list"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-zlib": "*",
    "k2gl/dsse": "^1.3",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1|^2.0",
    "psr/simple-cache": "^1.0|^2.0|^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10|^11|^12",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "~1.20.0",
    "k2gl/phpunit-fluent-assertions": "^12",
    "nyholm/psr7": "^1.8",
    "k2gl/composer-attest": "^1.1",
    "k2gl/composer-license-gate": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "k2gl/composer-attest": true,
      "k2gl/composer-license-gate": true
    }
  },
  "extra": {
    "k2gl-attest": {
      "mode": "warn"
    },
    "k2gl-license-gate": {
      "mode": "warn",
      "allow": ["MIT", "BSD-2-Clause", "BSD-3-Clause", "Apache-2.0", "ISC"]
    }
  },
  "suggest": {
    "ext-openssl": "Required for ES256/ES384/ES512 and RS256 signing and verification.",
    "ext-sodium": "Required for EdDSA signing and verification."
  },
  "autoload": {
    "psr-4": {
      "K2gl\\TokenStatusList\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "K2gl\\TokenStatusList\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs": "pint --test",
    "cs-fix": "pint",
    "check": [
      "@test",
      "@phpstan",
      "@cs"
    ]
  }
}
